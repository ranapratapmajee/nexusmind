# ====== Environment ======
APP_ENV=development

# ====== API (FastAPI) ======
API_HOST=0.0.0.0
API_PORT=8001

# ====== Frontend (Streamlit) ======
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501

# ====== ChromaDB Vector Store ======
CHROMA_DB_PATH=./chroma-data
CHROMA_COLLECTION=document_chunks
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ====== Neo4j Graph Database ======
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rana1234
NEO4J_DATABASE=neo4j

# ====== MCP Server ======
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=3000
MCP_TRANSPORT=http

# ====== Ollama (Local LLM) ======
OLLAMA_BASE_URL=http://localhost:11434

# ====== Cloud LLM Secrets (Only ONE needed) ======
GEMINI_API_KEY=your-api-key

# ====== Data Paths ======
OFFLINE_PDF_DIR=./data

# ====== Logging ======
LOG_LEVEL=INFO
