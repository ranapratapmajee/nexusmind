# path: .env

# ====== Environment ======
APP_ENV=development

# ====== API (FastAPI) ======
API_HOST=0.0.0.0
API_PORT=8001

# ====== Frontend (Streamlit / SPA) ======
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501

# ====== Database & Cache ======
DATABASE_URL=sqlite:///./nexusmind.db
REDIS_URL=redis://localhost:6379/0

# ====== Vector Store Infrastructure ======
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ====== Local model server (Ollama) ======
OLLAMA_BASE_URL=http://localhost:11434

# ====== Cloud LLM keys (secrets) ======
GEMINI_API_KEY=your-api-key-here

# ====== Data paths ======
OFFLINE_PDF_DIR=./data

# ====== Logging ======
LOG_LEVEL=INFO

# ====== Config file path ======
NEXUS_CONFIG_PATH=config.yaml